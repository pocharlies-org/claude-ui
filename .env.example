# Authentication — shared Bearer token for all API routes and MCP server
CLAUDE_UI_SECRET=change-me-in-production

# LiteLLM — same namespace: http://litellm:4000 (or full FQDN: http://litellm.devopsai.svc.cluster.local:4000)
LITELLM_URL=http://litellm:4000
LITELLM_API_KEY=

# Anthropic API key for claude CLI
ANTHROPIC_API_KEY=

# SQLite database (PVC mount at /data)
DATABASE_URL=file:./dev.db

# MCP server port (exposed to OpenClaw)
MCP_PORT=3100

# NEXT_PUBLIC_ vars are embedded in the browser bundle (internal tool only — acceptable tradeoff)
# Set same value as CLAUDE_UI_SECRET for local dev
NEXT_PUBLIC_CLAUDE_UI_SECRET=change-me-in-production
NEXT_PUBLIC_LITELLM_URL=http://litellm:4000
NEXT_PUBLIC_MCP_PORT=3100
