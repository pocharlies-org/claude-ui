# ─── Google OAuth (required for browser auth) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── NextAuth.js ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Bearer token (webhooks, MCP, machine-to-machine auth) ────────────
CLAUDE_UI_SECRET=change-me-in-production

# ─── Credential encryption (Phase 3) ──────────────────────────────────
# Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# ─── LiteLLM ──────────────────────────────────────────────────────────
LITELLM_URL=http://litellm:4000
LITELLM_API_KEY=

# ─── SQLite database (PVC mount at /data in production) ────────────────
DATABASE_URL=file:./dev.db

# ─── MCP server port (exposed to OpenClaw) ─────────────────────────────
MCP_PORT=3100

# ─── Public vars (embedded in browser bundle) ──────────────────────────
NEXT_PUBLIC_LITELLM_URL=http://litellm:4000
NEXT_PUBLIC_MCP_PORT=3100
