generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── NextAuth.js models ───────────────────────────────────────────────

model User {
  id                   String         @id @default(cuid())
  name                 String?
  email                String         @unique
  emailVerified        DateTime?
  image                String?
  isAdmin              Boolean        @default(false)
  encryptedCredentials String?
  credentialsLinkedAt  DateTime?
  accounts             Account[]
  sessions             Session[]
  agentSessions        AgentSession[]
  executions           Execution[]
  cronJobs             CronJob[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ───────────────────────────────────────────────

model AgentSession {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  soul          String
  skills        String         @default("[]")
  rules         String         @default("[]")
  mcpServers    String         @default("[]")
  model         String         @default("claude-opus-4-6")
  maxTurns      Int?
  maxConcurrent Int            @default(1)
  createdBy     String?
  creator       User?          @relation(fields: [createdBy], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  executions    Execution[]
  cronJobs      CronJob[]
  webhookTokens WebhookToken[]

  @@map("AgentSession")
}

model Execution {
  id                String       @id @default(cuid())
  sessionId         String
  session           AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  triggeredBy       String
  triggeredByUserId String?
  triggeredByUser   User?        @relation(fields: [triggeredByUserId], references: [id])
  triggerSource     String?
  prompt            String
  soulOverride      String?
  skillsOverride    String?
  rulesOverride     String?
  status            String       @default("running")
  output            String?
  exitCode          Int?
  startedAt         DateTime     @default(now())
  completedAt       DateTime?
  durationMs        Int?
}

model CronJob {
  id           String       @id @default(cuid())
  name         String
  sessionId    String
  session      AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schedule     String
  timezone     String       @default("UTC")
  prompt       String
  soulOverride String?
  enabled      Boolean      @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdBy    String?
  creator      User?        @relation(fields: [createdBy], references: [id])
  createdAt    DateTime     @default(now())
}

model WebhookToken {
  id         String       @id @default(cuid())
  name       String
  tokenHash  String       @unique
  sessionId  String
  session    AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
}
